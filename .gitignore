# Sauvegardes creees par les scripts de deploiement
*.bak
*.bak-*

# Donnees locales / caches jamais versionnees
*.log
*.sqlite
*.sqlite-*
*.sock

# Secrets (ne doivent jamais etre commites)
*.key
*.pem
*.pfx
*.kdbx
*.kdb
.env
.env.*
secrets.*
!secrets.*.example

# Cles SSH et configs reseau sensibles — restaurees depuis le disque conserve,
# jamais versionnees ici.
id_rsa
id_ecdsa
id_ed25519
id_dsa
*_rsa
*_ed25519
*.ppk
ssh/
.ssh/
*.wgconf
wg*.conf

# OS
Thumbs.db
.DS_Store
desktop.ini

# video-ai : jamais de poids de modeles, de rendus ni de config locale dans Git.
# Le runtime (ComfyUI, venv, modeles, projets) vit hors depot : E:\video-ai (VIDEO_AI_HOME).
video-ai/config/local.json
*.safetensors
*.ckpt
*.gguf
*.pt
*.pth
*.onnx
*.part
__pycache__/
*.pyc
video-ai/**/*.mp4
video-ai/**/*.mov
video-ai/**/*.webm
video-ai/**/*.wav
video-ai/**/*.mp3
video-ai/**/*.flac
video-ai/assets/characters/*/
!video-ai/assets/characters/_template/
