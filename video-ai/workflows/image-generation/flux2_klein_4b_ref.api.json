{
  "1": {"class_type": "UNETLoader", "_meta": {"title": "Load Diffusion Model"},
        "inputs": {"unet_name": "flux-2-klein-4b-fp8.safetensors", "weight_dtype": "default"}},
  "2": {"class_type": "CLIPLoader", "_meta": {"title": "Load Text Encoder (Qwen3 4B)"},
        "inputs": {"clip_name": "qwen_3_4b.safetensors", "type": "flux2", "device": "default"}},
  "3": {"class_type": "VAELoader", "_meta": {"title": "Load VAE"},
        "inputs": {"vae_name": "flux2-vae.safetensors"}},
  "4": {"class_type": "CLIPTextEncode", "_meta": {"title": "Prompt"},
        "inputs": {"clip": ["2", 0], "text": ""}},
  "5": {"class_type": "ConditioningZeroOut", "_meta": {"title": "Negative (zero)"},
        "inputs": {"conditioning": ["4", 0]}},
  "14": {"class_type": "LoadImage", "_meta": {"title": "Reference image"},
         "inputs": {"image": "example.png"}},
  "15": {"class_type": "ImageScaleToTotalPixels", "_meta": {"title": "Scale reference (~1 MP)"},
         "inputs": {"image": ["14", 0], "upscale_method": "lanczos", "megapixels": 1.0, "resolution_steps": 1}},
  "16": {"class_type": "VAEEncode", "_meta": {"title": "Encode reference"},
         "inputs": {"pixels": ["15", 0], "vae": ["3", 0]}},
  "17": {"class_type": "ReferenceLatent", "_meta": {"title": "Reference -> positive"},
         "inputs": {"conditioning": ["4", 0], "latent": ["16", 0]}},
  "18": {"class_type": "ReferenceLatent", "_meta": {"title": "Reference -> negative"},
         "inputs": {"conditioning": ["5", 0], "latent": ["16", 0]}},
  "6": {"class_type": "CFGGuider", "_meta": {"title": "CFG Guider"},
        "inputs": {"model": ["1", 0], "positive": ["17", 0], "negative": ["18", 0], "cfg": 1.0}},
  "7": {"class_type": "RandomNoise", "_meta": {"title": "Seed"},
        "inputs": {"noise_seed": 0}},
  "8": {"class_type": "KSamplerSelect", "_meta": {"title": "Sampler"},
        "inputs": {"sampler_name": "euler"}},
  "9": {"class_type": "Flux2Scheduler", "_meta": {"title": "Scheduler"},
        "inputs": {"steps": 4, "width": 1024, "height": 1024}},
  "10": {"class_type": "EmptyFlux2LatentImage", "_meta": {"title": "Latent"},
         "inputs": {"width": 1024, "height": 1024, "batch_size": 1}},
  "11": {"class_type": "SamplerCustomAdvanced", "_meta": {"title": "Sample"},
         "inputs": {"noise": ["7", 0], "guider": ["6", 0], "sampler": ["8", 0], "sigmas": ["9", 0], "latent_image": ["10", 0]}},
  "12": {"class_type": "VAEDecode", "_meta": {"title": "Decode"},
         "inputs": {"samples": ["11", 0], "vae": ["3", 0]}},
  "13": {"class_type": "SaveImage", "_meta": {"title": "Save"},
         "inputs": {"images": ["12", 0], "filename_prefix": "vai/flux2klein-ref"}}
}
